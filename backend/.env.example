# Copia este archivo a .env y ajusta los valores para tu entorno.
# En producción, DATABASE_URL debe apuntar a PostgreSQL (ver sección H del blueprint):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/ai_life_planner
DATABASE_URL=sqlite:///./ai_life_planner.db

# Genera uno real con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

ENVIRONMENT=development

# En producción, restringe esto al dominio real del frontend (ver sección J
# del blueprint) — separa varios orígenes con coma. "*" es solo para
# desarrollo local.
CORS_ALLOWED_ORIGINS=*

# Asistente con IA real (sección 16 del brief, ver app/assistant/llm_client.py).
# Opcional: sin esto, el asistente sigue funcionando con el intérprete de
# intención basado en reglas (app/assistant/parser.py::parse_rule_based).
# Consigue una key en console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
ASSISTANT_LLM_MODEL=claude-haiku-4-5-20251001
